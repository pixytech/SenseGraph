{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*"
    ],
    "production": [
      "default",
      "!{projectRoot}/tests/**/*",
      "!{projectRoot}/**/*.md"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "inputs": [
        "production",
        "^production"
      ]
    },
    "test": {
      "cache": true
    },
    "typecheck": {
      "cache": true
    },
    "build-wasm-node": {
      "cache": true
    },
    "build-wasm-web": {
      "cache": true
    }
  },
  "cli": {
    "packageManager": "npm"
  }
}
